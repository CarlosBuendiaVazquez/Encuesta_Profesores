const PocketBase = require('pocketbase/cjs');\
\
// Variable para mantener la conexi\'f3n (singleton)\
let pbInstance = null;\
\
/**\
 * Obtiene una instancia de PocketBase autenticada como admin\
 * Las credenciales vienen de las variables de entorno de Netlify\
 */\
async function getPocketBaseAdmin() \{\
    // Si ya tenemos una instancia, la reutilizamos\
    if (pbInstance) \{\
        return pbInstance;\
    \}\
\
    // Verificar que las variables de entorno existan\
    if (!process.env.POCKETBASE_URL) \{\
        throw new Error('
\f1 \uc0\u10060 
\f0  Falta POCKETBASE_URL en variables de entorno');\
    \}\
    if (!process.env.POCKETBASE_ADMIN_EMAIL) \{\
        throw new Error('
\f1 \uc0\u10060 
\f0  Falta POCKETBASE_ADMIN_EMAIL en variables de entorno');\
    \}\
    if (!process.env.POCKETBASE_ADMIN_PASSWORD) \{\
        throw new Error('
\f1 \uc0\u10060 
\f0  Falta POCKETBASE_ADMIN_PASSWORD en variables de entorno');\
    \}\
\
    // Crear nueva conexi\'f3n\
    const pb = new PocketBase(process.env.POCKETBASE_URL);\
    \
    try \{\
        // Autenticar como admin\
        await pb.admins.authWithPassword(\
            process.env.POCKETBASE_ADMIN_EMAIL,\
            process.env.POCKETBASE_ADMIN_PASSWORD\
        );\
        \
        console.log('
\f1 \uc0\u9989 
\f0  Conectado a PocketBase como admin');\
        pbInstance = pb;\
        return pb;\
        \
    \} catch (error) \{\
        console.error('
\f1 \uc0\u10060 
\f0  Error al autenticar con PocketBase:', error);\
        throw new Error('No se pudo autenticar con PocketBase');\
    \}\
\}\
\
module.exports = \{ getPocketBaseAdmin \};}